<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FF000000" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:visibility="invisible" />

    <!-- 폰을 돌리면 이 판 전체가 돌아갑니다 -->
    <FrameLayout
        android:id="@+id/uiRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <com.yangkim.logcamera.LevelView
            android:id="@+id/level"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 상단 정보 -->
        <LinearLayout
            android:id="@+id/infoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#55000000"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/infoMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#FFF5F0EA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/infoSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="2dp"
                android:text="—"
                android:textColor="#BBFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <com.yangkim.logcamera.HistogramView
            android:id="@+id/histogram"
            android:layout_width="112dp"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="66dp" />

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="72dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/chip_bg"
            android:fontFamily="monospace"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="● 00:00"
            android:textColor="#FFFF6B57"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- 줌 레버 + 현재 화각 -->
        <LinearLayout
            android:id="@+id/leverBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/focalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:fontFamily="monospace"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingRight="8dp"
                android:paddingBottom="3dp"
                android:text="24mm"
                android:textColor="#FFFFE2C4"
                android:textSize="13sp" />

            <com.yangkim.logcamera.ZoomLever
                android:id="@+id/zoomLever"
                android:layout_width="52dp"
                android:layout_height="220dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 버튼: 세로는 아래, 가로는 오른쪽 -->
        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#55000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/focalRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/settingsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/btnFps" style="@style/Ctl" android:text="30p" />
                <TextView android:id="@+id/btnWb" style="@style/Ctl" android:text="AWB" />
                <TextView android:id="@+id/btnAe" style="@style/Ctl" android:text="AE" />
                <TextView android:id="@+id/btnMode" style="@style/Ctl" android:text="영상" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shutterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/thumb"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/chip_bg"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/shutter"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/shutter_video" />

                <TextView
                    android:id="@+id/btnCamera"
                    style="@style/Ctl"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:layout_margin="10dp"
                    android:text="후면" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
